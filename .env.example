# Copy this file to .env or pass it via --env-file.
# Shell environment variables override these values.

POSTGRES_DSN=postgres://stock_cache:stock_cache@localhost:5432/stock_cache
TUSHARE_TOKEN=replace-with-a-valid-tushare-token

INDEX_LIST_PATH=config/default-indexes.csv
DEFAULT_LOOKBACK_TRADING_DAYS=90
MAX_CONCURRENCY=4
CACHE_WARMUP_CONCURRENCY=1
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=1
WRITE_BATCH_SIZE=1000
# Set to a positive integer to override automatic calc chunk sizing.
# CALC_CHUNK_SIZE=120
LOG_LEVEL=info
