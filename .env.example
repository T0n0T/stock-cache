# Copy this file to .env or pass it via --env-file.
# Shell environment variables override these values.

# --- 凭据 / 必填 -----------------------------------------------------------
# PostgreSQL 连接串：postgres://用户:密码@主机:端口/库名
POSTGRES_DSN=postgres://stock_cache:stock_cache@localhost:5432/stock_cache
# Tushare Pro API token，到 tushare.pro 注册获取；拉取行情时必填
TUSHARE_TOKEN=replace-with-a-valid-tushare-token

# --- 路径 ------------------------------------------------------------------
# 默认指数列表 CSV 路径，决定要缓存哪些指数
INDEX_LIST_PATH=config/default-indexes.csv

# --- 运行时调优 ------------------------------------------------------------
# 默认回看的交易日数（非自然日），用于增量拉取/补数据的默认时间窗口
DEFAULT_LOOKBACK_TRADING_DAYS=90
# Tushare 请求最大并发数；过高会被 Tushare 限流
MAX_CONCURRENCY=4
# 缓存预热阶段并发数（必须 >0），保持低并发以免打满上游
CACHE_WARMUP_CONCURRENCY=1
# 单次 Tushare 请求超时（秒），网络慢时可调大
REQUEST_TIMEOUT_SECONDS=30
# 失败请求的最大重试次数
MAX_RETRIES=3
# 重试退避基准延迟（秒），按指数递增（如 1s、2s、4s...）
RETRY_BASE_DELAY_SECONDS=1
# 写入 Postgres 的批大小（每批行数），更大则更高效但更耗内存
WRITE_BATCH_SIZE=1000
# 计算阶段分块大小；留空=自动。设为正整数可覆盖自动分片
# CALC_CHUNK_SIZE=120
# 日志级别：debug / info / warn / error；排查问题时设 debug
LOG_LEVEL=info
