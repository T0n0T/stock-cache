# Copy to .env or export these values before invoking the Rust CLI.
TUSHARE_TOKEN=replace-with-a-valid-tushare-token
# Optional Rust HTTP endpoint override.
# TUSHARE_ENDPOINT=https://api.tushare.pro

# Tushare HTTP controls; all values are optional.
TUSHARE_HTTP_TIMEOUT_SECS=30
TUSHARE_HTTP_MAX_RETRIES=3
TUSHARE_HTTP_RETRY_BACKOFF_MS=250
# TUSHARE_HTTP_PAGE_SIZE=5000
# TUSHARE_HTTP_MAX_PAGES=100

# Market-cache workflow (write --mode full/cache/calc).
DUCKDB_PATH=runtime/stock-cache.duckdb
DEFAULT_LOOKBACK_TRADING_DAYS=90
MAX_CONCURRENCY=4
CALC_CHUNK_SIZE=64
# INDEX_LIST_PATH=config/default-indexes.csv
# TARGET_CACHE_TABLES_PATH=config/target-cache-tables.txt
